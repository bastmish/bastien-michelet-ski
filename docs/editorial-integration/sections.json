    "compact_source_only": [
      {
        "index": 0,
        "text": "03 / LES EXPÉRIENCES",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 4,
        "text": "Apprendre à skier, reprendre confiance ou simplement profiter pleinement de la montagne. Nos moniteurs vous accompagnent à votre rythme, avec un enseignement adapté à votre niveau et à vos envies.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 8,
        "text": "Vous skiez déjà bien et souhaitez aller plus loin ? Affinez vos appuis, gagnez en précision et travaillez votre technique avec des moniteurs qui connaissent les exigences de la compétition.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 11,
        "text": "Quittez les pistes balisées pour découvrir une autre facette de la montagne. Des sorties adaptées à votre niveau et aux conditions du jour, avec des moniteurs disposant des qualifications nécessaires à l'itinéraire envisagé.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 14,
        "text": "Vos premières courbes, une technique à perfectionner ou l'envie de découvrir de nouveaux terrains. Profitez de cours privés de snowboard conçus autour de votre niveau et de votre pratique.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      }
    ]
  },
  {
    "page": "index.html",
    "section": "A04",
    "blocks": 14,
    "status": "PASS",
    "components": [
      [
        "ss-formats-compact"
      ]
    ],
    "missing": [],
    "compact_source_only": [
      {
        "index": 0,
        "text": "04 / VOTRE PROGRAMME",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 2,
        "text": "Quelques heures pour progresser, une journée entière pour profiter de la montagne ou une expérience imaginée sur mesure. Choisissez le format qui vous correspond, nous nous occupons du reste.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 4,
        "text": "Quelques heures pour faire la différence.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 5,
        "text": "Un cours privé pour découvrir le ski, retrouver des sensations ou travailler un point technique précis. Un format idéal pour progresser à votre rythme, sans mobiliser toute votre journée.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 7,
        "text": "Une journée, entièrement à vous.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 8,
        "text": "Prenez le temps de skier, de progresser et de découvrir la montagne avec votre moniteur. Le programme s'adapte à votre niveau, à vos envies et aux conditions du jour.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 10,
        "text": "Votre montagne, vos envies.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      },
      {
        "index": 11,
        "text": "Une sortie particulière, une expérience en groupe ou un projet qui sort des formats habituels ? Parlez-nous de ce que vous imaginez. Nous étudions ensemble les possibilités avec les moniteurs du collectif.",
        "status": "Preserved in immutable editorial source; omitted from compact home by instruction"
      }
    ]
  },
